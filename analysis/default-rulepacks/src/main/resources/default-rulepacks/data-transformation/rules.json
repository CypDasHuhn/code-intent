{
  "rules": {
    "data-transformation:data-transformation": {
      "kind": "transformation",
      "exactCalls": [
        "map",
        "mapNotNull",
        "mapValues",
        "mapKeys",
        "flatMap",
        "filter",
        "filterNot",
        "filterIsInstance",
        "filterNotNull",
        "fold",
        "foldIndexed",
        "reduce",
        "reduceIndexed",
        "collect",
        "collectLatest",
        "distinct",
        "distinctBy",
        "sorted",
        "sortedBy",
        "sortedWith",
        "sortedDescending",
        "sortedByDescending",
        "groupBy",
        "groupingBy",
        "associate",
        "associateBy",
        "associateWith",
        "partition",
        "take",
        "takeWhile",
        "takeLast",
        "drop",
        "dropWhile",
        "dropLast",
        "chunked",
        "windowed",
        "zip",
        "zipWithNext",
        "flatten",
        "all",
        "any",
        "none",
        "Select",
        "SelectMany",
        "Where",
        "Aggregate",
        "GroupBy",
        "Distinct",
        "OrderBy",
        "ToList",
        "ToArray"
      ],
      "candidateCalls": [
        "transform",
        "process",
        "reshape",
        "convert",
        "apply",
        "adjust",
        "Transform",
        "Process",
        "Reshape",
        "Convert",
        "Apply",
        "Adjust"
      ],
      "candidatePrefixes": [
        "transform",
        "process",
        "reshape",
        "convert"
      ],
      "receiverQualifiers": [
        "list",
        "lists",
        "items",
        "values",
        "uses",
        "collection",
        "collections",
        "stream",
        "streams",
        "sequence",
        "sequences",
        "array",
        "arrays",
        "set",
        "sets",
        "map",
        "maps",
        "entries",
        "elements",
        "nodes",
        "results",
        "rows",
        "records",
        "children"
      ]
    }
  }
}
