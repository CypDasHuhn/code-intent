{
  "rules": {
    "normalization:normalization": {
      "kind": "normalization",
      "exactCalls": [
        "trim",
        "trimStart",
        "trimEnd",
        "lowercase",
        "uppercase",
        "toLowerCase",
        "toUpperCase",
        "toInt",
        "toLong",
        "toShort",
        "toByte",
        "toDouble",
        "toFloat",
        "toBigDecimal",
        "toBigInteger",
        "toPath",
        "toUri",
        "parseInt",
        "parseLong",
        "parseDouble",
        "parseFloat",
        "parseBoolean",
        "fromString",
        "normalize",
        "canonicalize",
        "decodeFromString",
        "String",
        "Number"
      ],
      "instanceCalls": [
        "trim",
        "trimStart",
        "trimEnd",
        "lowercase",
        "uppercase",
        "toLocaleLowerCase",
        "toLocaleUpperCase",
        "toLowerCase",
        "toUpperCase",
        "toInt",
        "toLong",
        "toShort",
        "toByte",
        "toDouble",
        "toFloat",
        "toBigDecimal",
        "toBigInteger",
        "toPath",
        "toUri",
        "normalize"
      ],
      "candidateCalls": [
        "format",
        "stringify"
      ],
      "candidatePrefixes": [
        "format",
        "pretty",
        "display"
      ],
      "receiverQualifiers": [
        "String",
        "Json",
        "Integer",
        "Long",
        "Short",
        "Byte",
        "Double",
        "Float",
        "Boolean",
        "BigDecimal",
        "BigInteger",
        "LocalDate",
        "LocalDateTime",
        "LocalTime",
        "Instant",
        "OffsetDateTime",
        "ZonedDateTime",
        "Duration",
        "Period",
        "UUID",
        "Path",
        "Paths",
        "Files",
        "DateTimeFormatter",
        "Charsets"
      ]
    }
  }
}
